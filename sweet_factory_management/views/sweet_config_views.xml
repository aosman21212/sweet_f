<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Quality Parameter Form View -->
    <record id="view_sweet_quality_parameter_form" model="ir.ui.view">
        <field name="name">sweet.quality.parameter.form</field>
        <field name="model">sweet.quality.parameter</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="category"/>
                            <field name="parameter_type"/>
                            <field name="uom"/>
                        </group>
                    </group>
                    <group string="Acceptable Range">
                        <group>
                            <field name="min_value"/>
                            <field name="max_value"/>
                            <field name="target_value"/>
                        </group>
                    </group>
                    <group string="Description / Test Method">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Quality Parameter List View -->
    <record id="view_sweet_quality_parameter_list" model="ir.ui.view">
        <field name="name">sweet.quality.parameter.list</field>
        <field name="model">sweet.quality.parameter</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code" optional="show"/>
                <field name="category"/>
                <field name="parameter_type"/>
                <field name="uom"/>
                <field name="min_value"/>
                <field name="max_value"/>
                <field name="target_value"/>
                <field name="active" optional="show"/>
            </list>
        </field>
    </record>

    <!-- Quality Parameter Search View -->
    <record id="view_sweet_quality_parameter_search" model="ir.ui.view">
        <field name="name">sweet.quality.parameter.search</field>
        <field name="model">sweet.quality.parameter</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <filter string="Physical" name="filter_physical" domain="[('category','=','physical')]"/>
                <filter string="Chemical" name="filter_chemical" domain="[('category','=','chemical')]"/>
                <filter string="Microbiological" name="filter_micro" domain="[('category','=','microbiological')]"/>
                <filter string="Sensory" name="filter_sensory" domain="[('category','=','sensory')]"/>
                <filter string="Archived" name="filter_archived" domain="[('active','=',False)]"/>
                <group>
                    <filter string="Category" name="group_category" context="{'group_by': 'category'}"/>
                    <filter string="Type" name="group_type" context="{'group_by': 'parameter_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Quality Parameter Action -->
    <record id="action_sweet_quality_parameter" model="ir.actions.act_window">
        <field name="name">Quality Parameters</field>
        <field name="res_model">sweet.quality.parameter</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define quality parameters for your products!
            </p>
            <p>Set acceptable ranges for physical, chemical, and sensory properties.</p>
        </field>
    </record>

</odoo>
