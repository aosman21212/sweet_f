<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Batch Form View -->
    <record id="view_sweet_batch_form" model="ir.ui.view">
        <field name="name">sweet.batch.form</field>
        <field name="model">sweet.batch</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" string="Confirm" type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_start" string="Start Production" type="object"
                            class="btn-primary"
                            invisible="state != 'confirmed'"/>
                    <button name="action_quality_check" string="Quality Check" type="object"
                            class="btn-primary"
                            invisible="state != 'in_progress'"/>
                    <button name="action_done" string="Mark Done" type="object"
                            class="btn-success"
                            invisible="state not in ['in_progress', 'quality_check']"/>
                    <button name="action_fail" string="Fail Batch" type="object"
                            class="btn-danger"
                            invisible="state in ['done', 'cancelled', 'failed']"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state in ['done', 'cancelled', 'failed']"/>
                    <button name="action_reset_draft" string="Reset to Draft" type="object"
                            invisible="state not in ['confirmed', 'cancelled', 'failed']"/>
                    <button name="action_print_batch_report" string="Print Report" type="object"
                            icon="fa-print"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,in_progress,quality_check,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_quality_checks" type="object"
                                class="oe_stat_button" icon="fa-check-circle">
                            <field name="quality_check_count" string="QC Checks" widget="statinfo"/>
                        </button>
                        <button type="object" name="action_create_quality_check"
                                class="oe_stat_button" icon="fa-plus-circle"
                                invisible="state not in ['in_progress', 'quality_check']">
                            <span class="o_stat_text">Create QC Check</span>
                        </button>
                        <div class="oe_stat_button" icon="fa-shield">
                            <field name="quality_passed" widget="boolean_toggle" readonly="1"/>
                            <div class="o_stat_text">QC Passed</div>
                        </div>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="recipe_id"/>
                            <field name="sweet_type" readonly="1"/>
                            <field name="date_planned"/>
                            <field name="date_start" readonly="1"/>
                            <field name="date_end" readonly="1"/>
                        </group>
                        <group>
                            <field name="planned_qty"/>
                            <field name="actual_yield" readonly="1"/>
                            <field name="yield_variance" readonly="1"/>
                            <field name="yield_percentage_actual" readonly="1"/>
                            <field name="shift"/>
                            <field name="supervisor_id"/>
                            <field name="operator_id"/>
                            <field name="machine_id"/>
                        </group>
                    </group>
                    <group>
                        <group string="Traceability">
                            <field name="production_date"/>
                            <field name="expiry_date"/>
                            <field name="lot_id"/>
                        </group>
                        <group string="Cost Summary">
                            <field name="total_ingredient_cost" widget="monetary"
                                   options="{'currency_field': 'currency_id'}"/>
                            <field name="cost_per_kg" widget="monetary"
                                   options="{'currency_field': 'currency_id'}"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Ingredients" name="ingredients">
                            <field name="ingredient_line_ids" widget="one2many">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"/>
                                    <field name="ingredient_type" optional="show"/>
                                    <field name="planned_qty"/>
                                    <field name="actual_qty"/>
                                    <field name="product_uom_id" optional="show"/>
                                    <field name="variance" optional="show"/>
                                    <field name="lot_id" optional="show"/>
                                    <field name="cost_per_unit" optional="show"/>
                                    <field name="line_cost" optional="show"/>
                                    <field name="notes" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Output Products" name="output">
                            <field name="output_line_ids" widget="one2many">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"/>
                                    <field name="planned_qty"/>
                                    <field name="actual_qty"/>
                                    <field name="product_uom_id" optional="show"/>
                                    <field name="grade"/>
                                    <field name="packaging_type" optional="show"/>
                                    <field name="pieces_per_kg" optional="show"/>
                                    <field name="total_pieces" optional="show"/>
                                    <field name="lot_id" optional="show"/>
                                    <field name="expiry_date" optional="show"/>
                                    <field name="notes" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Process Parameters" name="process">
                            <group>
                                <group string="Actual Readings">
                                    <field name="actual_cooking_temp"/>
                                    <field name="actual_cooling_temp"/>
                                    <field name="actual_duration"/>
                                </group>
                                <group string="Recipe Reference">
                                    <field name="recipe_id" readonly="1"/>
                                </group>
                            </group>
                        </page>
                        <page string="Notes" name="notes_tab">
                            <field name="notes" widget="html"/>
                            <group>
                                <field name="rejection_reason"
                                       invisible="state not in ['failed', 'cancelled']"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Batch List View -->
    <record id="view_sweet_batch_list" model="ir.ui.view">
        <field name="name">sweet.batch.list</field>
        <field name="model">sweet.batch</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'done'"
                  decoration-info="state == 'in_progress'"
                  decoration-warning="state == 'quality_check'"
                  decoration-danger="state == 'failed'"
                  decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="recipe_id"/>
                <field name="sweet_type"/>
                <field name="date_planned"/>
                <field name="planned_qty"/>
                <field name="actual_yield" optional="show"/>
                <field name="shift" optional="show"/>
                <field name="supervisor_id" optional="show"/>
                <field name="machine_id" optional="show"/>
                <field name="quality_passed" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state == 'in_progress'"
                       decoration-warning="state == 'quality_check'"
                       decoration-danger="state == 'failed'"
                       decoration-muted="state in ['cancelled', 'draft']"/>
            </list>
        </field>
    </record>

    <!-- Batch Search View -->
    <record id="view_sweet_batch_search" model="ir.ui.view">
        <field name="name">sweet.batch.search</field>
        <field name="model">sweet.batch</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="recipe_id"/>
                <field name="sweet_type"/>
                <field name="supervisor_id"/>
                <filter string="Draft" name="filter_draft" domain="[('state','=','draft')]"/>
                <filter string="Confirmed" name="filter_confirmed" domain="[('state','=','confirmed')]"/>
                <filter string="In Production" name="filter_in_progress" domain="[('state','=','in_progress')]"/>
                <filter string="Quality Check" name="filter_qc" domain="[('state','=','quality_check')]"/>
                <filter string="Done" name="filter_done" domain="[('state','=','done')]"/>
                <filter string="Failed" name="filter_failed" domain="[('state','=','failed')]"/>
                <separator/>
                <filter string="Today" name="filter_today"
                        domain="[('date_planned','&gt;=', datetime.datetime.combine(context_today(), datetime.time(0,0,0))),
                                 ('date_planned','&lt;=', datetime.datetime.combine(context_today(), datetime.time(23,59,59)))]"/>
                <group>
                    <filter string="Recipe" name="group_recipe" context="{'group_by': 'recipe_id'}"/>
                    <filter string="Sweet Type" name="group_sweet_type" context="{'group_by': 'sweet_type'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Shift" name="group_shift" context="{'group_by': 'shift'}"/>
                    <filter string="Planned Date" name="group_date" context="{'group_by': 'date_planned:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Batch Action -->
    <record id="action_sweet_batch" model="ir.actions.act_window">
        <field name="name">Production Batches</field>
        <field name="res_model">sweet.batch</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first production batch!
            </p>
            <p>Track production runs from start to finish with full ingredient consumption and output recording.</p>
        </field>
    </record>

    <!-- Batch Action Today -->
    <record id="action_sweet_batch_today" model="ir.actions.act_window">
        <field name="name">Today's Batches</field>
        <field name="res_model">sweet.batch</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', 'not in', ['done', 'cancelled', 'failed'])]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No active batches today.
            </p>
        </field>
    </record>

</odoo>
