<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===== QUALITY PARAMETERS ===== -->
    <record id="demo_qp_moisture" model="sweet.quality.parameter">
        <field name="name">Moisture Content</field>
        <field name="code">QP-001</field>
        <field name="sequence">10</field>
        <field name="category">physical</field>
        <field name="parameter_type">numeric</field>
        <field name="uom">%</field>
        <field name="min_value">0.0</field>
        <field name="max_value">3.0</field>
        <field name="target_value">1.5</field>
        <field name="description">Measure moisture content using moisture analyzer at 105°C for 30 minutes.</field>
    </record>

    <record id="demo_qp_brix" model="sweet.quality.parameter">
        <field name="name">Brix / Sugar Concentration</field>
        <field name="code">QP-002</field>
        <field name="sequence">20</field>
        <field name="category">chemical</field>
        <field name="parameter_type">numeric</field>
        <field name="uom">Brix</field>
        <field name="min_value">68.0</field>
        <field name="max_value">72.0</field>
        <field name="target_value">70.0</field>
        <field name="description">Measure using refractometer on dissolved sample at 20°C.</field>
    </record>

    <record id="demo_qp_ph" model="sweet.quality.parameter">
        <field name="name">pH Level</field>
        <field name="code">QP-003</field>
        <field name="sequence">30</field>
        <field name="category">chemical</field>
        <field name="parameter_type">numeric</field>
        <field name="uom">pH</field>
        <field name="min_value">3.0</field>
        <field name="max_value">5.0</field>
        <field name="target_value">4.0</field>
        <field name="description">Measure using calibrated pH meter on 10% solution at 25°C.</field>
    </record>

    <record id="demo_qp_weight" model="sweet.quality.parameter">
        <field name="name">Weight per Piece</field>
        <field name="code">QP-004</field>
        <field name="sequence">40</field>
        <field name="category">weight</field>
        <field name="parameter_type">numeric</field>
        <field name="uom">g</field>
        <field name="min_value">8.0</field>
        <field name="max_value">12.0</field>
        <field name="target_value">10.0</field>
        <field name="description">Weigh 10 random pieces on calibrated scale and record average.</field>
    </record>

    <record id="demo_qp_color" model="sweet.quality.parameter">
        <field name="name">Color Appearance</field>
        <field name="code">QP-005</field>
        <field name="sequence">50</field>
        <field name="category">sensory</field>
        <field name="parameter_type">boolean</field>
        <field name="description">Visual inspection: check uniformity, intensity and absence of discoloration.</field>
    </record>

    <record id="demo_qp_texture" model="sweet.quality.parameter">
        <field name="name">Hardness / Texture</field>
        <field name="code">QP-006</field>
        <field name="sequence">60</field>
        <field name="category">sensory</field>
        <field name="parameter_type">boolean</field>
        <field name="description">Manual texture evaluation: firmness, chewiness, absence of stickiness.</field>
    </record>

    <record id="demo_qp_micro" model="sweet.quality.parameter">
        <field name="name">Microbiological Safety</field>
        <field name="code">QP-007</field>
        <field name="sequence">70</field>
        <field name="category">microbiological</field>
        <field name="parameter_type">boolean</field>
        <field name="description">TPC, Yeast &amp; Mould, Coliforms within food safety limits per GCC standards.</field>
    </record>

    <record id="demo_qp_packaging" model="sweet.quality.parameter">
        <field name="name">Packaging Integrity</field>
        <field name="code">QP-008</field>
        <field name="sequence">80</field>
        <field name="category">packaging</field>
        <field name="parameter_type">boolean</field>
        <field name="description">Check seal integrity, label accuracy, barcode readability, and no damage.</field>
    </record>

