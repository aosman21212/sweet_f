<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="res_groups_privilege_sweet_factory" model="res.groups.privilege">
            <field name="name">Sweet Factory</field>
            <field name="category_id" ref="base.module_category_manufacturing"/>
            <field name="sequence">110</field>
        </record>

        <record id="group_sweet_factory_user" model="res.groups">
            <field name="name">User</field>
            <field name="privilege_id" ref="res_groups_privilege_sweet_factory"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="sequence">10</field>
        </record>

        <record id="group_sweet_factory_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="privilege_id" ref="res_groups_privilege_sweet_factory"/>
            <field name="implied_ids" eval="[(4, ref('group_sweet_factory_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
            <field name="sequence">20</field>
        </record>
    </data>
</odoo>
